# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/ai-business-os

# JWT secret - koi bhi random long string daalo
JWT_SECRET=change_this_to_a_long_random_secret

# Groq API key (https://console.groq.com se free key milti hai)
GROQ_API_KEY=your_groq_api_key_here

# Server port
PORT=5000
